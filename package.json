{
  "name": "emojis-plus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prebuild": "node scripts/prepare-static.mjs && tsx scripts/prepare-previews.ts && node scripts/package-agent-skill.mjs",
    "start": "node scripts/local-launcher.mjs",
    "serve": "node scripts/static-server.mjs",
    "test": "tsx --test tests/browser-*.test.ts",
    "bridge": "node integrations/emojis-plus-agent/scripts/bridge.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "vite": "^6.3.0",
    "wawoff2": "^2.0.1"
  }
}
