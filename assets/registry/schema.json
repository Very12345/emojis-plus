{
  "$defs": {
    "AnimationDefinition": {
      "additionalProperties": false,
      "properties": {
        "handler": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Handler",
          "type": "string"
        },
        "duration_ms": {
          "default": 2000,
          "maximum": 6000,
          "minimum": 1000,
          "multipleOf": 100,
          "title": "Duration Ms",
          "type": "integer"
        },
        "poster_time": {
          "default": 0.4,
          "exclusiveMaximum": 1,
          "minimum": 0,
          "title": "Poster Time",
          "type": "number"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/AnimationTrack"
          },
          "maxItems": 6,
          "title": "Tracks",
          "type": "array"
        },
        "props": {
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Props",
          "type": "array"
        },
        "parameters": {
          "items": {
            "enum": [
              "strength",
              "copies",
              "direction",
              "prop_color"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Parameters",
          "type": "array"
        }
      },
      "required": [
        "handler"
      ],
      "title": "AnimationDefinition",
      "type": "object"
    },
    "AnimationTrack": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Actor",
          "type": "integer"
        },
        "keyframes": {
          "items": {
            "$ref": "#/$defs/Keyframe"
          },
          "maxItems": 32,
          "minItems": 2,
          "title": "Keyframes",
          "type": "array"
        }
      },
      "required": [
        "keyframes"
      ],
      "title": "AnimationTrack",
      "type": "object"
    },
    "AssetSelector": {
